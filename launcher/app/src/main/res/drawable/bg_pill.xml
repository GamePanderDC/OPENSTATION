<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#341B2B45"
                android:endColor="#28101C2E" />
            <stroke android:width="1.1dp" android:color="#68BAE6FD" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#44243B55" />
            <stroke android:width="1.1dp" android:color="#88BAE6FD" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#30FFFFFF"
                android:endColor="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#487DD3FC" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1EFFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
