<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#881B2C47"
                android:endColor="#6E101A2C" />
            <stroke android:width="0.9dp" android:color="#68BAE6FD" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#9923385A" />
            <stroke android:width="1dp" android:color="#88BAE6FD" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3A1D3557"
                android:endColor="#28122038" />
            <stroke android:width="0.8dp" android:color="#687DD3FC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#16FFFFFF"
                android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
